Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Map
        - /LiDAR 0
        - /LiDAR 1
        - /Semantic Targets
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Goal Pose1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz/Views
    Expanded:
      - /Current View
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.65
      Class: rviz/Map
      Color Scheme: map
      Enabled: true
      Name: Global Map
      Topic: /global_map_2d
      Value: true
    - Alpha: 0.30
      Class: rviz/Map
      Color Scheme: costmap
      Enabled: true
      Name: UAV0 Local Map
      Topic: /uav0/local_map_2d
      Value: true
    - Alpha: 0.30
      Class: rviz/Map
      Color Scheme: costmap
      Enabled: true
      Name: UAV1 Local Map
      Topic: /uav1/local_map_2d
      Value: true
    - Class: rviz/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Name: LiDAR 0
      Size (Pixels): 2
      Style: Points
      Topic: /uav0/lidar/points
      Value: true
    - Class: rviz/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Name: LiDAR 1
      Size (Pixels): 2
      Style: Points
      Topic: /uav1/lidar/points
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Semantic Targets
      Topic: /semantic_map/target_markers
      Value: true
    - Class: rviz/PoseArray
      Enabled: true
      Name: UAV Map Poses
      Topic: /global_map_uav_poses
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 26; 115; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: UAV0 History
      Topic: /trajectory/uav0/path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 51; 38
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: UAV1 History
      Topic: /trajectory/uav1/path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 26; 204; 77
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: UGV0 History
      Topic: /trajectory/ugv0/path
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Trajectory Overlap
      Topic: /trajectory/markers
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.7
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 45
      Value: TopDownOrtho (rviz)
Window Geometry:
  Height: 900
  Width: 1400
  X: 40
  Y: 40
